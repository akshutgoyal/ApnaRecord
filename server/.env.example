PORT=5000
NODE_ENV=development

# --- Database (optional) -----------------------------------------------------
# MongoDB is a CACHE, never a source of truth. The API runs without it and
# rebuilds record metadata from chain logs; start it to get the fast index.
#
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority
# Local:  mongodb://localhost:27017/apnarecord
#
# Two things that catch everyone out:
#   1. The database NAME goes in the path. Omit it and Mongo quietly uses `test`.
#   2. If the password contains @ : / ? # [ ] % it must be percent-encoded.
#
# Check it with:  npm run ping
DATABASE_URL=

# --- Chain (read-only) -------------------------------------------------------
# The server holds NO signing key. Every write is signed in the browser by the
# user's own wallet, so there is nothing here for an attacker to steal.
#
# The one exception is the dripper below, which pays gas. It cannot sign as any
# user — only send them test ETH.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CONTRACT_ADDRESS=0x0afBDd549aE57818A428Be35ee55d7f6715CD5cA
# Binds read signatures to this chain. Changing it invalidates every signed read,
# which is the point — a signature harvested on one chain is useless on another.
CHAIN_ID=11155111
# The block the contract was created in — Etherscan shows it on the creation tx.
# Setting this skips a ~24-call binary search for the first block of code.
# Omit it and the server finds the block itself.
CONTRACT_DEPLOY_BLOCK=11714309

# --- The gas float ("dripper") ------------------------------------------------
# Funds each new wallet so nobody has to acquire test ETH before they can act.
# Without this, wallets are still created — they just cannot write anything.
#
# The key here is a wallet YOU control, funded by hand. There is no automatic
# replenishment by design — it would mean mining proof-of-work on the application
# server to satisfy a faucet, for a float that costs nothing to top up manually.
#
# The requirements this wallet must also satisfy:
#   - generate it with:  npm run dripper:new     (prints address + key)
#   - the address must never be reused where the balance has value
DRIPPER_PRIVATE_KEY=
DRIP_AMOUNT=0.01          # per new wallet. ~100 writes at 2 gwei
DRIP_FLOOR=0.003          # top up only when a wallet falls below this
DRIP_DAILY_CAP=1.0        # circuit breaker, in ETH, per calendar day
DRIP_LOW_WATER=0.05       # warn loudly below this

# --- Identity: the verified email address -------------------------------------
# An email address locates a wallet. It can never open one — that always takes the
# recovery code — which is what keeps a compromised inbox from being a records breach.
#
# Only a keyed hash and a masked form of the address are ever stored. The plaintext
# exists inside the send call and nowhere else, so a database dump reveals neither
# who is registered nor any working code.
#
# The default sender is `mock`: it prints the code to the server log and returns it
# to the browser, so the whole flow works with no relay account, no verified domain
# and no DNS records. That is what makes this runnable today. Set EMAIL_PROVIDER to
# send real messages.
EMAIL_PROVIDER=mock

# Required by BOTH real providers, and the reason verification mail lands in an inbox
# rather than a spam folder. It must be an address on a domain you have verified with
# the relay, with SPF, DKIM and DMARC published. Miss any of those and codes simply do
# not arrive — a failure that looks exactly like a broken server.
EMAIL_FROM="ApnaRecord <no-reply@yourdomain.com>"

# resend: free tier is 3,000 messages/month. Verify the domain, then take an API key.
# RESEND_API_KEY=

# brevo: free tier is 300 messages/day.
# BREVO_API_KEY=

# --- Abuse limits --------------------------------------------------------------
# Lower these in production; raise them only to run a test suite.
CONTACT_MAX_PER_IP=12             # codes per caller IP per hour
CONTACT_MAX_PER_HOUR=5            # codes per address per hour
CONTACT_RESEND_COOLDOWN_MS=30000  # minimum gap between requests for one address

# --- Key sealing -------------------------------------------------------------
# 64 hex chars. Seals each record's content key at rest, and keys the hash used to
# look addresses up — so this is required for enrolment, not just uploads.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=

# --- Uploads (optional) ------------------------------------------------------
# Where ciphertext blobs and their sealed keys are written. Defaults to
# server/uploads. Point it at a persistent disk in production, because most
# free hosts wipe the local filesystem on every deploy.
# UPLOAD_DIR=/opt/apnarecord/uploads
