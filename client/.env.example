VITE_API_URL=http://localhost:5000/api
VITE_CONTRACT_ADDRESS=0x0afBDd549aE57818A428Be35ee55d7f6715CD5cA
VITE_CHAIN_ID=11155111

# --- Chain reads and writes without an extension ------------------------------
# When a wallet was created here rather than connected through MetaMask, there is
# no injected provider to borrow — so the client talks to an RPC endpoint itself.
# The default is a free public node, which is fine to develop against but rate
# limits under load; point this at your own provider (Alchemy, Infura, QuickNode)
# before anything resembling a demo, or writes will fail at the worst moment.
#
# Note that writes broadcast from the browser, so this endpoint sees the user's
# IP. Relaying signed transactions through our own backend is the planned fix.
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
