VITE_API_URL=http://localhost:5000/api
VITE_CONTRACT_ADDRESS=
# Must match the server's CHAIN_ID. It is bound into the EIP-712 read domain, and a
# mismatch rejects every signed read while looking like a permissions bug.
VITE_CHAIN_ID=84532
VITE_CHAIN_NAME=Base Sepolia
# Address links and transaction links. Both are appended to, so they need the
# trailing slash. Kept separate because they differ: Basescan uses /address/ and
# /tx/, and a scan of this repo's history shows the wrong one being easy to miss.
VITE_EXPLORER=https://sepolia.basescan.org/address/
VITE_TX_EXPLORER=https://sepolia.basescan.org/tx/

# --- Chain reads and writes without an extension ------------------------------
# Leave this UNSET and the client reads and writes through our own backend
# (/api/rpc), so a public node never sees the user's IP. Set it only as a
# deliberate escape hatch for when the API itself is down.
#
# VITE_RPC_URL=https://sepolia.base.org
