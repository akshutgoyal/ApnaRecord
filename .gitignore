# Dependencies
node_modules/
.pnp/
.pnp.js

# Build outputs
dist/
build/
coverage/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Credential exports — anything *-credentials.env or *.credentials.
# The plain `.env` rule above only matches that exact filename, so a file named
# `atlas-credentials.env` would otherwise be committed by a careless `git add .`.
*.credentials
*-credentials.env
atlas-credentials.env

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Record blobs — ciphertext only, never commit them.
server/uploads/

# Editor / OS files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
