{
  "name": "apnarecord",
  "version": "1.0.0",
  "private": true,
  "description": "Patient-owned medical records, verifiable by anyone, instantly.",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build:client": "npm run build --workspace=client",
    "start:server": "npm run start --workspace=server",
    "index": "npm run index --workspace=server",
    "ping": "npm run ping --workspace=server",
    "dripper:new": "npm run dripper:new --workspace=server",
    "compile:contracts": "node scripts/compile-contracts.mjs",
    "test": "node tests/run.mjs",
    "test:unit": "node tests/unit/email.test.mjs",
    "test:contract": "node tests/contract/account.test.mjs"
  },
  "keywords": [
    "health records",
    "blockchain",
    "soulbound",
    "consent",
    "ethereum",
    "sepolia"
  ],
  "license": "MIT",
  "devDependencies": {
    "ganache": "7.9.2",
    "solc": "0.8.37"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.0.2"
  }
}
